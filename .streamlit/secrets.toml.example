# Copy this file to `.streamlit/secrets.toml` for local use, OR paste these
# lines into the "Secrets" box when deploying on Streamlit Community Cloud.
# NEVER commit the real secrets.toml — it is git-ignored.

# --- Operator logins -------------------------------------------------------
# A JSON object mapping username -> SHA-256 password hash.
# Generate a hash with:  python scripts/make_login.py
RABBI_USERS = '{"admin": "REPLACE_WITH_SHA256_HASH"}'

# --- Persistent storage (recommended for daily use) ------------------------
# A database connection string so your item/customer lists survive restarts.
# Get a free one from Neon (https://neon.tech) and paste it here.
# Leave this line out entirely to use local files instead (laptop only).
# DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
